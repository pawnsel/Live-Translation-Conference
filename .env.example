# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored; this file is not — never put
# a real key here.
# ---------------------------------------------------------------------------

# ===========================================================================
#  Supabase — sign-in and the account-approval table
# ===========================================================================
# From Supabase → Project Settings → API. Both are read by the browser, so
# they MUST keep the VITE_ prefix (anything else is server-only and invisible
# to the app). The anon key is safe to ship: row-level security in
# supabase/schema.sql is what actually guards the data.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# The app SERVER reads these two as well (server/auth.ts verifies every caller
# before spending the Gemini key). It falls back to the VITE_ names above, so
# one copy is enough — set SUPABASE_URL / SUPABASE_ANON_KEY only if you ever
# need the server pointed somewhere else.
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# Only addresses on this domain — and its subdomains, e.g.
# student.chula.ac.th — may register. Leave unset to use chula.ac.th.
# If you change it, update the access_requests_allowed_domain CHECK
# constraint in supabase/schema.sql to match, or inserts will be rejected.
# VITE_ALLOWED_EMAIL_DOMAIN="chula.ac.th"

# Setup checklist (once per Supabase project):
#   1. SQL Editor → run supabase/schema.sql
#   2. Authentication → Providers → Google: enable, paste the Google Cloud
#      OAuth client id + secret, and copy the callback URL it shows into that
#      Google client's "Authorized redirect URIs". Sign-in is Google-only:
#      turn the Email provider OFF.
#   3. Authentication → URL Configuration:
#        Site URL       http://localhost:3000
#        Redirect URLs  http://localhost:3000/auth/callback
#                       (add the production URL here too)
#   4. Approve accounts by hand: SQL Editor →
#        update public.access_requests set status = 'approved' where email = '…';

# ===========================================================================
#  Gemini — transcription, translation, summarisation (server-side)
# ===========================================================================
# Required for Gemini AI API calls. Never VITE_-prefixed: it must not reach
# the browser.
GEMINI_API_KEY=your-gemini-api-key-here

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Model used for /api/gemini/transcribe (must support audio input). Override
# here if a better-suited model becomes available without a code change.
GEMINI_MODEL="gemini-3.6-flash"

# Model used for /api/gemini/summarize (text-only). Falls back to
# GEMINI_MODEL above if unset.
# GEMINI_SUMMARY_MODEL="gemini-3.6-flash"

# Live captions model for the realtime console.
# GEMINI_LIVE_MODEL="gemini-3.5-live-translate-preview"
